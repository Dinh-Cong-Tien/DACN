# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL with pgAdmin 4)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/orbilingo_db?schema=public"

# Authentication & Security
JWT_SECRET="orbilingo-super-secure-jwt-secret-key-2026"
JWT_EXPIRES_IN="7d"

# CORS Origin
FRONTEND_URL="http://localhost:3000"

# Đăng nhập một chạm (OAuth2) — để trống nếu chưa dùng
# Google: console.cloud.google.com → APIs & Services → Credentials → OAuth client ID (Web application)
GOOGLE_CLIENT_ID=""
# Facebook: developers.facebook.com → My Apps → Create App (Facebook Login)
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
