// ⚠️ File sinh tự động từ prisma/schema-src/gen_schema.py — sửa ở đó rồi chạy lại.
// Đặc tả: KE_HOACH_TRIEN_KHAI_DU_AN.md mục X (18 phân hệ · 59 bảng).
// Ràng buộc Prisma không biểu diễn được (partial unique, CHECK, GIN trgm, EXCLUDE, view)
// nằm trong migration SQL thủ công: prisma/migrations/*_constraints_indexes_views.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgcrypto, pg_trgm, citext, unaccent, btree_gist]
}

enum UserRole {
  STUDENT
  TEACHER
  HEAD_TEACHER
  ADMIN

  @@map("user_role")
}

enum UserStatus {
  PENDING
  ACTIVE
  LOCKED

  @@map("user_status")
}

enum TokenType {
  REFRESH
  EMAIL_VERIFY
  PASSWORD_RESET
  EMAIL_CHANGE

  @@map("token_type")
}

enum ExamType {
  TOEIC
  VSTEP

  @@map("exam_type")
}

enum SkillType {
  LISTENING
  READING
  WRITING
  SPEAKING
  VOCABULARY
  GRAMMAR

  @@map("skill_type")
}

enum ExamPart {
  TOEIC_P1
  TOEIC_P2
  TOEIC_P3
  TOEIC_P4
  TOEIC_P5
  TOEIC_P6
  TOEIC_P7
  VSTEP_L1
  VSTEP_L2
  VSTEP_L3
  VSTEP_R1
  VSTEP_R2
  VSTEP_R3
  VSTEP_R4
  VSTEP_W1
  VSTEP_W2
  VSTEP_S1
  VSTEP_S2
  VSTEP_S3

  @@map("exam_part")
}

enum CefrLevel {
  A1
  A2
  B1
  B2
  C1
  C2

  @@map("cefr_level")
}

enum ContentStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  ARCHIVED

  @@map("content_status")
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  TRUE_FALSE_NOT_GIVEN
  FILL_IN_BLANK
  MATCHING
  ESSAY
  SPEAKING_RESPONSE

  @@map("question_type")
}

enum CourseTrack {
  TOEIC
  VSTEP
  THPT

  @@map("course_track")
}

enum CourseCategory {
  FOUNDATION
  GRAMMAR
  VOCABULARY
  SKILL
  EXAM_PREP

  @@map("course_category")
}

enum LessonType {
  VIDEO
  READING
  QUIZ
  CHECKPOINT

  @@map("lesson_type")
}

enum ProgressStatus {
  LOCKED
  AVAILABLE
  IN_PROGRESS
  COMPLETED

  @@map("progress_status")
}

enum TestKind {
  FULL
  MINI
  PLACEMENT
  DIAGNOSTIC
  QUIZ
  CHECKPOINT

  @@map("test_kind")
}

enum AttemptMode {
  FULL
  PRACTICE
  ADAPTIVE
  DRILL
  PART_SESSION
  LESSON_QUIZ
  DICTATION

  @@map("attempt_mode")
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  GRADING
  COMPLETED
  ABANDONED
  EXPIRED

  @@map("attempt_status")
}

enum MistakeCause {
  GRAMMAR
  VOCABULARY
  LISTENING
  READING
  TIME_PRESSURE
  CARELESS
  UNCLASSIFIED

  @@map("mistake_cause")
}

enum SrsStatus {
  NEW
  LEARNING
  REVIEWING
  MASTERED
  SUSPENDED

  @@map("srs_status")
}

enum PathItemType {
  LESSON
  PRACTICE
  MOCK_TEST
  REVIEW
  VOCAB
  GRAMMAR

  @@map("path_item_type")
}

enum AssignmentType {
  MOCK_TEST
  PRACTICE
  LESSON
  GRAMMAR
  VOCAB
  ESSAY
  SPEAKING
  DICTATION

  @@map("assignment_type")
}

enum SubmissionStatus {
  TODO
  SUBMITTED
  LATE
  GRADED
  MISSED

  @@map("submission_status")
}

enum GraderType {
  AI
  TEACHER

  @@map("grader_type")
}

enum ReviewResult {
  PENDING
  AGREED
  ADJUSTED

  @@map("review_result")
}

enum NotificationType {
  REVIEW
  ASSIGNMENT
  ACHIEVEMENT
  SYSTEM
  CLASS
  PAYMENT

  @@map("notification_type")
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED

  @@map("subscription_status")
}

enum PaymentMethod {
  MOMO
  VNPAY
  CARD
  BANK

  @@map("payment_method")
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED

  @@map("payment_status")
}

enum TicketCategory {
  ACCOUNT
  PAYMENT
  EXAM
  CONTENT
  ACADEMIC
  OTHER

  @@map("ticket_category")
}

enum TicketStatus {
  OPEN
  IN_REVIEW
  PENDING
  RESOLVED
  REJECTED

  @@map("ticket_status")
}

enum AiMode {
  COPILOT
  ROLEPLAY
  SPEAKING_PARTNER

  @@map("ai_mode")
}

model User {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email String @db.Citext
  passwordHash String? @db.VarChar(255) @map("password_hash")
  googleId String? @unique @db.VarChar(64) @map("google_id")
  facebookId String? @unique @db.VarChar(64) @map("facebook_id")
  role UserRole @default(STUDENT)
  status UserStatus @default(PENDING)
  emailVerifiedAt DateTime? @db.Timestamptz(6) @map("email_verified_at")
  lockedReason String? @map("locked_reason")
  fullName String @db.VarChar(120) @map("full_name")
  avatarUrl String? @map("avatar_url")
  phone String? @db.VarChar(20)
  dateOfBirth DateTime? @db.Date @map("date_of_birth")
  gender String? @db.VarChar(10)
  organization String? @db.VarChar(160)
  city String? @db.VarChar(80)
  bio String?
  departmentId String? @db.Uuid @map("department_id")
  department Department? @relation("User_department", fields: [departmentId], references: [id], onDelete: SetNull)
  xpTotal Int @default(0) @map("xp_total")
  streakCurrent Int @default(0) @map("streak_current")
  streakLongest Int @default(0) @map("streak_longest")
  streakFreezes Int @default(0) @db.SmallInt @map("streak_freezes")
  lastStudyDate DateTime? @db.Date @map("last_study_date")
  lastActiveAt DateTime? @db.Timestamptz(6) @map("last_active_at")
  settings Json @default("{}")
  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")
  deletedAt DateTime? @db.Timestamptz(6) @map("deleted_at")
  userTokenUsers UserToken[] @relation("UserToken_user")
  rolePermissionGrantedBys RolePermission[] @relation("RolePermission_grantedBy")
  auditLogActors AuditLog[] @relation("AuditLog_actor")
  departmentHeads Department[] @relation("Department_head")
  learningGoalUsers LearningGoal[] @relation("LearningGoal_user")
  userAbilityUsers UserAbility[] @relation("UserAbility_user")
  learningPathUsers LearningPath[] @relation("LearningPath_user")
  mediaFileOwners MediaFile[] @relation("MediaFile_owner")
  courseAuthors Course[] @relation("Course_author")
  courseReviewedBys Course[] @relation("Course_reviewedBy")
  lessonReviewedBys Lesson[] @relation("Lesson_reviewedBy")
  courseEnrollmentUsers CourseEnrollment[] @relation("CourseEnrollment_user")
  lessonProgressUsers LessonProgress[] @relation("LessonProgress_user")
  bookmarkUsers Bookmark[] @relation("Bookmark_user")
  passageAuthors Passage[] @relation("Passage_author")
  passageReviewedBys Passage[] @relation("Passage_reviewedBy")
  questionAuthors Question[] @relation("Question_author")
  questionReviewedBys Question[] @relation("Question_reviewedBy")
  questionVersionChangedBys QuestionVersion[] @relation("QuestionVersion_changedBy")
  mockTestAuthors MockTest[] @relation("MockTest_author")
  mockTestReviewedBys MockTest[] @relation("MockTest_reviewedBy")
  examAttemptUsers ExamAttempt[] @relation("ExamAttempt_user")
  gradingGraders Grading[] @relation("Grading_grader")
  gradingReviewers Grading[] @relation("Grading_reviewer")
  mistakeEntryUsers MistakeEntry[] @relation("MistakeEntry_user")
  srsCardUsers SrsCard[] @relation("SrsCard_user")
  srsReviewLogUsers SrsReviewLog[] @relation("SrsReviewLog_user")
  speakingRecordingUsers SpeakingRecording[] @relation("SpeakingRecording_user")
  aiConversationUsers AiConversation[] @relation("AiConversation_user")
  classTeachers Class[] @relation("Class_teacher")
  classMemberStudents ClassMember[] @relation("ClassMember_student")
  classSessionTeachers ClassSession[] @relation("ClassSession_teacher")
  classSessionObservers ClassSession[] @relation("ClassSession_observer")
  classAnnouncementAuthors ClassAnnouncement[] @relation("ClassAnnouncement_author")
  materialUploadedBys Material[] @relation("Material_uploadedBy")
  assignmentCreatedBys Assignment[] @relation("Assignment_createdBy")
  assignmentSubmissionStudents AssignmentSubmission[] @relation("AssignmentSubmission_student")
  studentNoteTeachers StudentNote[] @relation("StudentNote_teacher")
  studentNoteStudents StudentNote[] @relation("StudentNote_student")
  dailyActivityUsers DailyActivity[] @relation("DailyActivity_user")
  userAchievementUsers UserAchievement[] @relation("UserAchievement_user")
  certificateUsers Certificate[] @relation("Certificate_user")
  notificationUsers Notification[] @relation("Notification_user")
  broadcastCreatedBys Broadcast[] @relation("Broadcast_createdBy")
  userSubscriptionUsers UserSubscription[] @relation("UserSubscription_user")
  userSubscriptionGrantedBys UserSubscription[] @relation("UserSubscription_grantedBy")
  paymentTransactionUsers PaymentTransaction[] @relation("PaymentTransaction_user")
  ticketUsers Ticket[] @relation("Ticket_user")
  ticketAssignees Ticket[] @relation("Ticket_assignee")
  ticketMessageSenders TicketMessage[] @relation("TicketMessage_sender")
  postAuthors Post[] @relation("Post_author")
  testimonialUsers Testimonial[] @relation("Testimonial_user")
  systemSettingUpdatedBys SystemSetting[] @relation("SystemSetting_updatedBy")

  @@index([role])
  @@index([lastActiveAt])
  @@map("users")
}

model UserToken {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @db.Uuid @map("user_id")
  user User @relation("UserToken_user", fields: [userId], references: [id], onDelete: Cascade)
  type TokenType
  tokenHash String @unique @db.Char(64) @map("token_hash")
  familyId String? @db.Uuid @map("family_id")
  userAgent String? @map("user_agent")
  ipAddress String? @db.Inet @map("ip_address")
  expiresAt DateTime @db.Timestamptz(6) @map("expires_at")
  usedAt DateTime? @db.Timestamptz(6) @map("used_at")
  revokedAt DateTime? @db.Timestamptz(6) @map("revoked_at")
  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")

  @@index([userId])
  @@index([familyId])
  @@map("user_tokens")
}

model RolePermission {
  role UserRole
  permissionCode String @db.VarChar(80) @map("permission_code")
  grantedById String? @db.Uuid @map("granted_by_id")
  grantedBy User? @relation("RolePermission_grantedBy", fields: [grantedById], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")

  @@id([role, permissionCode])
  @@map("role_permissions")
}

model AuditLog {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId String? @db.Uuid @map("actor_id")
  actor User? @relation("AuditLog_actor", fields: [actorId], references: [id], onDelete: SetNull)
  actorRole UserRole? @map("actor_role")
  action String @db.VarChar(80)
  resourceType String @db.VarChar(40) @map("resource_type")
  resourceId String? @db.Uuid @map("resource_id")
  severity String @default("INFO") @db.VarChar(8)
  ipAddress String? @db.Inet @map("ip_address")
  beforeData Json? @map("before_data")
  afterData Json? @map("after_data")
  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")

  @@index([actorId])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model Department {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code String @unique @db.VarChar(20)
  name String @db.VarChar(120)
  examType ExamType @map("exam_type")
  headId String? @db.Uuid @map("head_id")
  head User? @relation("Department_head", fields: [headId], references: [id], onDelete: SetNull)
  description String?
  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")
  deletedAt DateTime? @db.Timestamptz(6) @map("deleted_at")
  userDepartments User[] @relation("User_department")
  courseDepartments Course[] @relation("Course_department")
  classDepartments Class[] @relation("Class_department")

  @@map("departments")
}

model LearningGoal {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @db.Uuid @map("user_id")
  user User @relation("LearningGoal_user", fields: [userId], references: [id], onDelete: Cascade)
  examType ExamType @map("exam_type")
  currentLevel String? @db.VarChar(20) @map("current_level")
  targetScore Int? @db.SmallInt @map("target_score")
  targetLevel CefrLevel? @map("target_level")
  targetDate DateTime? @db.Date @map("target_date")
  purpose String? @db.VarChar(20)
  studyDays Int[] @db.SmallInt @map("study_days")
  minutesPerDay Int @default(60) @db.SmallInt @map("minutes_per_day")
  preferredSlot String? @db.VarChar(10) @map("preferred_slot")
  isActive Boolean @default(true) @map("is_active")
  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")
  learningPathGoals LearningPath[] @relation("LearningPath_goal")

  @@index([userId])
  @@map("learning_goals")
}

model UserAbility {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @db.Uuid @map("user_id")
  user User @relation("UserAbility_user", fields: [userId], references: [id], onDelete: Cascade)
  examType ExamType @map("exam_type")
  skill SkillType
  tagId String? @db.Uuid @map("tag_id")
  tag SkillTag? @relation("UserAbility_tag", fields: [tagId], references: [id], onDelete: Cascade)
  theta Decimal? @db.Decimal(5, 3)
  thetaSe Decimal? @db.Decimal(5, 3) @map("theta_se")
  estimatedScore Int? @db.SmallInt @map("estimated_score")
  correctCount Int @default(0) @map("correct_count")
  totalCount Int @default(0) @map("total_count")
  mastery Decimal @default(0) @db.Decimal(4, 3)
  lastPracticedAt DateTime? @db.Timestamptz(6) @map("last_practiced_at")
  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")

  @@index([userId, mastery])
  @@map("user_abilities")
}

model LearningPath {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @db.Uuid @map("user_id")
  user User @relation("LearningPath_user", fields: [userId], references: [id], onDelete: Cascade)
  goalId String? @db.Uuid @map("goal_id")
  goal LearningGoal? @relation("LearningPath_goal", fields: [goalId], references: [id], onDelete: SetNull)
  examType ExamType @map("exam_type")
  generatedBy String @default("ALGORITHM") @db.VarChar(10) @map("generated_by")
  version Int @default(1) @db.SmallInt
  isActive Boolean @default(true) @map("is_active")
  progressPct Decimal @default(0) @db.Decimal(5, 2) @map("progress_pct")
  milestones Json
  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")
  learningPathItemPaths LearningPathItem[] @relation("LearningPathItem_path")

  @@index([userId])
  @@map("learning_paths")
}

model LearningPathItem {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pathId String @db.Uuid @map("path_id")
  path LearningPath @relation("LearningPathItem_path", fields: [pathId], references: [id], onDelete: Cascade)
  phase Int @db.SmallInt
  title String @db.VarChar(160)
  itemType PathItemType @map("item_type")
  refId String? @db.Uuid @map("ref_id")
  refConfig Json? @map("ref_config")
  skill SkillType?
  durationMin Int @db.SmallInt @map("duration_min")
  orderIndex Int @db.SmallInt @map("order_index")
  status ProgressStatus @default(LOCKED)
  completedAt DateTime? @db.Timestamptz(6) @map("completed_at")
  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")

  @@unique([pathId, phase, orderIndex])
  @@map("learning_path_items")
}

model MediaFile {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId String? @db.Uuid @map("owner_id")
  owner User? @relation("MediaFile_owner", fields: [ownerId], references: [id], onDelete: SetNull)
  storageKey String @unique @map("storage_key")
  url String
  mimeType String @db.VarChar(100) @map("mime_type")
  sizeBytes BigInt @map("size_bytes")
  durationSec Decimal? @db.Decimal(8, 2) @map("duration_sec")
  checksumSha256 String? @db.Char(64) @map("checksum_sha256")
  purpose String @db.VarChar(20)
  isPrivate Boolean @default(false) @map("is_private")
  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")
  deletedAt DateTime? @db.Timestamptz(6) @map("deleted_at")

  @@index([ownerId])
  @@index([checksumSha256])
  @@map("media_files")
}

model Course {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug String @db.VarChar(140)
  title String @db.VarChar(200)
  category CourseCategory
  examType ExamType? @map("exam_type")
  /// Mục chính của khoá trong menu Khoá học: TOEIC / VSTEP / Tiếng Anh THPT
  track CourseTrack?
  /// Nhóm trong mục chính (vd "Listening · Part 1–4", "Lớp 10")
  trackGroup String? @db.VarChar(60) @map("track_group")
  /// Thứ tự khoá trong mục chính
  trackOrder Int @default(0) @db.SmallInt @map("track_order")
  level CefrLevel?
  description String
  coverUrl String? @map("cover_url")
  themeGradient String? @db.VarChar(80) @map("theme_gradient")
  isSequential Boolean @default(true) @map("is_sequential")
  isFree Boolean @default(false) @map("is_free")
  authorId String? @db.Uuid @map("author_id")
  author User? @relation("Course_author", fields: [authorId], references: [id], onDelete: SetNull)
  departmentId String? @db.Uuid @map("department_id")
  department Department? @relation("Course_department", fields: [departmentId], references: [id], onDelete: SetNull)
  status ContentStatus @default(DRAFT)
  reviewedById String? @db.Uuid @map("reviewed_by_id")
  reviewedBy User? @relation("Course_reviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewNote String? @map("review_note")
  lessonsCount Int @default(0) @db.SmallInt @map("lessons_count")
  durationMin Int @default(0) @map("duration_min")
  studentsCount Int @default(0) @map("students_count")
  ratingAvg Decimal @default(0) @db.Decimal(3, 2) @map("rating_avg")
  ratingCount Int @default(0) @map("rating_count")
  publishedAt DateTime? @db.Timestamptz(6) @map("published_at")
  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")
  deletedAt DateTime? @db.Timestamptz(6) @map("deleted_at")
  courseSectionCourses CourseSection[] @relation("CourseSection_course")
  courseEnrollmentCourses CourseEnrollment[] @relation("CourseEnrollment_course")
  certificateCourses Certificate[] @relation("Certificate_course")

  classes Class[] @relation("Class_course")
  @@index([category])
  @@index([track])
  @@index([status])
  @@map("courses")
}

model CourseSection {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseId String @db.Uuid @map("course_id")
  course Course @relation("CourseSection_course", fields: [courseId], references: [id], onDelete: Cascade)
  partNo Int @default(1) @db.SmallInt @map("part_no")
  partTitle String? @db.VarChar(120) @map("part_title")
  title String @db.VarChar(200)
  orderIndex Int @db.SmallInt @map("order_index")
  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")
  lessonSections Lesson[] @relation("Lesson_section")

  @@unique([courseId, orderIndex])
  @@map("course_sections")
}

model Lesson {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sectionId String @db.Uuid @map("section_id")
  section CourseSection @relation("Lesson_section", fields: [sectionId], references: [id], onDelete: Cascade)
  title String @db.VarChar(200)
  type LessonType
  summary String? @db.VarChar(300)
  contentMd String? @map("content_md")
  skill SkillType?
  videoUrl String? @map("video_url")
  audioUrl String? @map("audio_url")
  transcript Json?
  knowledge Json?
  exercises Json?
  quizTestId String? @db.Uuid @map("quiz_test_id")
  quizTest MockTest? @relation("Lesson_quizTest", fields: [quizTestId], references: [id], onDelete: Restrict)
  passScorePct Int? @db.SmallInt @map("pass_score_pct")
  durationMin Int @default(10) @db.SmallInt @map("duration_min")
  isFreePreview Boolean @default(false) @map("is_free_preview")
  orderIndex Int @db.SmallInt @map("order_index")
  status ContentStatus @default(DRAFT)
  reviewedById String? @db.Uuid @map("reviewed_by_id")
  reviewedBy User? @relation("Lesson_reviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewNote String? @map("review_note")
  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")
  deletedAt DateTime? @db.Timestamptz(6) @map("deleted_at")
  courseEnrollmentCurrentLessons CourseEnrollment[] @relation("CourseEnrollment_currentLesson")
  lessonProgressLessons LessonProgress[] @relation("LessonProgress_lesson")
  passageSourceLessons Passage[] @relation("Passage_sourceLesson")
  examAttemptLessons ExamAttempt[] @relation("ExamAttempt_lesson")

  @@unique([sectionId, orderIndex])
  @@map("lessons")
}

model CourseEnrollment {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @db.Uuid @map("user_id")
  user User @relation("CourseEnrollment_user", fields: [userId], references: [id], onDelete: Cascade)
  courseId String @db.Uuid @map("course_id")
  course Course @relation("CourseEnrollment_course", fields: [courseId], references: [id], onDelete: Cascade)
  source String @default("SELF") @db.VarChar(10)
